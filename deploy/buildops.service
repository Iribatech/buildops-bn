[Unit]
Description=BuildOps API
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/buildops
EnvironmentFile=/var/www/buildops/.env
# Port 3000 on this server belongs to another app. nginx proxies
# buildopbn.kazilink.online to 127.0.0.1:3100. Set here rather than in .env so a
# stray PORT line there cannot move the API off the port nginx expects.
ExecStart=/usr/bin/env PORT=3100 /usr/bin/node dist/main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

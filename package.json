{
  "name": "ops-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "build": "node init && nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node init && nest start",
    "start:dev": "node init && nest start --watch",
    "start:debug": "node init && nest start --debug --watch",
    "start:prod": "node init && node dist/main",
    "lint": "oxlint src/ test/",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:cov:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e-cov.json --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "docs:openapi": "NODE_OPTIONS=--experimental-vm-modules OPENAPI_WRITE=1 jest --config ./test/jest-e2e.json test/openapi-artifact.e2e-spec.ts",
    "typeorm": "node --env-file-if-exists=.env ./node_modules/typeorm/cli.js -d dist/database/data-source.js",
    "migration:run": "pnpm run build && pnpm run typeorm -- migration:run",
    "migration:revert": "pnpm run build && pnpm run typeorm -- migration:revert",
    "migration:generate": "pnpm run build && pnpm run typeorm -- migration:generate",
    "migration:show": "pnpm run build && pnpm run typeorm -- migration:show",
    "db:seed": "NODE_OPTIONS=--experimental-vm-modules node dist/scripts/seed.js",
    "db:setup": "pnpm run migration:run && pnpm run db:seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.3.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^8.2.0",
    "helmet": "^8.3.0",
    "mime-types": "^3.0.2",
    "multer": "2.5.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "stripe": "^23.0.0",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
